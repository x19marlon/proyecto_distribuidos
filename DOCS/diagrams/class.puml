@startuml class
title UML Class Diagram – Domain Model

skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

package domain {

  class Student {
    - studentId : String {id}
    - name : String
    - governmentIdType : GovernmentIdType
    - governmentId : String
    - career : String
    - department : String
    - semester : int
    - email : String {unique}
    - phone : String
    - balance : Decimal
    - active : boolean
    + canReserve() : boolean
    + hasBalance(amount : Decimal) : boolean
    + maskedGovernmentId() : String
  }

  class Place {
    - id : String {id}
    - name : String
    - type : PlaceType
    - capacity : int
  }

  class Event {
    - id : String {id}
    - name : String
    - placeId : String [0..1]
    - externalAddress : String [0..1]
    - externalCapacity : int [0..1]
    - price : Decimal
    + limit() : int
    + isPaid() : boolean
    + isExternal() : boolean
  }

  class EventDate {
    - id : String {id}
    - eventId : String
    - date : DateTime
    - reservations : int
    + available() : int
    + hasRoomFor(spots : int) : boolean
    + isPast() : boolean
  }

  class Reservation {
    - id : String {id}
    - studentId : String
    - eventDateId : String
    - spots : int
    - amountPaid : Decimal
    - status : ReservationStatus
    - createdAt : DateTime
    - updatedAt : DateTime
    + isActive() : boolean
    + costOfChange(newSpots : int, price : Decimal) : Decimal
  }

  class Transaction {
    - id : String {id}
    - studentId : String
    - reservationId : String [0..1]
    - type : TransactionType
    - fromEventDateId : String [0..1]
    - toEventDateId : String [0..1]
    - previousSpots : int
    - newSpots : int
    - amount : Decimal
    - status : TransactionStatus
    - createdAt : DateTime
    - requestId : String {unique}
  }

  class CancellationRequest <<message>> {
    - requestId : String
    - reservationId : String
    - studentId : String
    - acceptedAt : DateTime
    - attempts : int
  }

  class TimingRecord {
    - requestId : String
    - layer : Layer
    - operation : String
    - start : DateTime
    - end : DateTime
    - result : String
    + durationMs() : long
  }

  enum PlaceType {
    BUILDING
    THEATER
  }

  enum GovernmentIdType {
    CC
    TI
    CE
    PASSPORT
  }

  enum ReservationStatus {
    ACTIVE
    CANCELLED
  }

  enum TransactionType {
    RESERVATION
    MODIFICATION
    CANCELLATION
    TOP_UP
  }

  enum TransactionStatus {
    PENDING
    COMMITTED
    FAILED
  }

  enum Layer {
    CONSUMER
    SERVICES
    PERSISTENCE
  }
}

Student "1" -- "0..*" Reservation : holds >
Student "1" -- "0..*" Transaction : makes >
Event "1" *-- "1..*" EventDate : happens on >
Place "0..1" -- "0..*" Event : hosts >
EventDate "1" -- "0..*" Reservation : booked by >
Reservation "1" -- "1..*" Transaction : history >
CancellationRequest "0..*" ..> "1" Reservation : targets >
CancellationRequest ..> Transaction : becomes CANCELLATION >

Student --> GovernmentIdType
Place --> PlaceType
Reservation --> ReservationStatus
Transaction --> TransactionType
Transaction --> TransactionStatus
TimingRecord --> Layer

note bottom of Event
  Exactly one of placeId / externalAddress.
  limit() = place.capacity if placeId
            else externalCapacity
end note

note bottom of EventDate
  0 <= reservations <= event.limit()
  reservations = sum(spots of ACTIVE reservations)
end note

note right of Transaction
  Immutable once COMMITTED.
  amount < 0: charge, > 0: refund / top-up
end note

@enduml
