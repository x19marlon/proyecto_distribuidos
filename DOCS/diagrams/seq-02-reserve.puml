@startuml seq-02-reserve
title Sequence 2 – Reserve N spots on an event date (synchronous)

skinparam shadowing false
autonumber

actor Student
participant "Student\nConsumer" as C
participant "Auth\nModule" as A
participant "Transaction\nService" as TS
participant "Student\nService" as SS
participant "Event\nService" as ES
participant "Persistence\nService" as P
database "Database" as DB

Student -> C : reserve N spots on date D
activate C
C -> C : requestId = newUUID()
C -> TS : reserve(token, requestId, D, N)
activate TS
TS -> A : validateToken(token)
A --> TS : studentId (from token)

TS -> P : findTransactionByRequestId(requestId)
activate P
P --> TS : not found
deactivate P

TS -> SS : getStudent(studentId)
activate SS
SS -> P : getStudent(studentId)
P --> SS : Student
SS --> TS : Student
deactivate SS

TS -> ES : getEventDate(D)
activate ES
ES -> P : getEventDate(D), getEvent, getPlace
P --> ES : EventDate, Event, Place
ES --> TS : EventDate + limit + price
deactivate ES

TS -> TS : validate:\nactive, not past, N >= 1,\navailable >= N, no active reservation\nfor this event, balance >= N x price

alt validation fails
  TS --> C : ERROR (e.g. NOT_ENOUGH_SPOTS)
else validation ok
  TS -> P : applyReservationChange(tx, newReservation,\n[D: +N], balance: -N x price)
  activate P
  P -> DB : BEGIN
  activate DB
  P -> DB : UPDATE event_date SET reservations = reservations + N\nWHERE id = D AND reservations + N <= limit
  P -> DB : UPDATE student SET balance = balance - cost\nWHERE id = ? AND balance >= cost
  P -> DB : INSERT reservation, INSERT transaction (COMMITTED)
  P -> DB : COMMIT
  DB --> P : ok
  deactivate DB
  P --> TS : COMMITTED
  deactivate P
  TS --> C : Reservation + Transaction
end
deactivate TS
C --> Student : show reservation
deactivate C

note right of P
  If any conditional UPDATE affects
  0 rows → ROLLBACK, NOT_ENOUGH_SPOTS
  or INSUFFICIENT_BALANCE.
  Protects against concurrent reservations.
end note

@enduml
