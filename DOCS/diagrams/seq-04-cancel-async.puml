@startuml seq-04-cancel-async
title Sequence 4 – Cancel a reservation (asynchronous)

skinparam shadowing false
autonumber

actor Student
participant "Student\nConsumer" as C
participant "Auth\nModule" as A
participant "Transaction\nService" as TS
queue "Cancellation\nQueue" as Q
participant "Cancellation\nWorker" as W
participant "Persistence\nService" as P
database "Database" as DB

== Phase 1: accept (synchronous, short) ==

Student -> C : cancel reservation R
activate C
C -> C : requestId = newUUID()
C -> TS : cancelReservation(token, requestId, R)
activate TS
TS -> A : validateToken(token)
A --> TS : studentId
TS -> TS : requestId already queued or processed?
TS -> P : getReservation(R)
activate P
P --> TS : Reservation
deactivate P
TS -> TS : validate: owner, ACTIVE,\ndate not past, no cancellation pending

alt validation fails
  TS --> C : ERROR (code)
else validation ok
  TS -> Q : enqueue(CancellationRequest{requestId, R, studentId})
  activate Q
  Q --> TS : stored (durable)
  deactivate Q
  TS --> C : ACCEPTED (requestId)\n"Your cancellation is in progress"
end
deactivate TS
C --> Student : show "cancellation in progress"
deactivate C

== Phase 2: create the cancellation (asynchronous) ==

W -> Q : take next message
activate W
Q --> W : CancellationRequest
W -> P : applyCancellation(tx, R)
activate P
P -> DB : BEGIN
activate DB
P -> DB : transaction with requestId exists?
alt already applied (redelivery)
  P -> DB : ROLLBACK
  P --> W : ALREADY_APPLIED
else reservation still ACTIVE
  P -> DB : UPDATE reservation SET status = CANCELLED
  P -> DB : UPDATE event_date SET reservations = reservations - spots
  P -> DB : UPDATE student SET balance = balance + amountPaid
  P -> DB : INSERT transaction (CANCELLATION, COMMITTED)
  P -> DB : COMMIT
  P --> W : COMMITTED
else no longer cancellable
  P -> DB : INSERT transaction (CANCELLATION, FAILED, reason)
  P -> DB : COMMIT
  P --> W : FAILED
end
deactivate DB
deactivate P
W -> Q : ack (remove message)
deactivate W

== Phase 3: student checks the result ==

Student -> C : check cancellation
activate C
C -> TS : getRequestStatus(token, requestId)
activate TS
TS -> P : findTransactionByRequestId(requestId)
P --> TS : transaction or none
TS --> C : PENDING / COMMITTED / FAILED
deactivate TS
C --> Student : show result
deactivate C

note over W, P
  If persistence is down, the worker does not ack:
  the message stays in the queue and is retried with backoff.
end note

@enduml
